# Copy to keystore.properties (untracked — add it to .gitignore if it
# isn't already covered) and fill in real values to enable a signed
# `release` build. Generate a keystore with:
#
#   keytool -genkey -v -keystore claymark-release.jks -keyalg RSA \
#     -keysize 2048 -validity 10000 -alias claymark
#
# Until this file exists with a real storeFile, `release` builds stay
# unsigned, same as before this signing config was wired up.
storeFile=/absolute/path/to/claymark-release.jks
storePassword=CHANGE_ME
keyAlias=claymark
keyPassword=CHANGE_ME
