{
  "name": "claymark",
  "version": "0.1.0-plan",
  "description": "A pixel-faithful, security-hardened Markdown rendering engine in the Claude visual idiom.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/claymark.cjs",
  "module": "./dist/claymark.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/claymark.js",
      "require": "./dist/claymark.cjs"
    }
  },
  "files": [
    "dist",
    "public/fonts"
  ],
  "scripts": {
    "build": "vite build",
    "build:app": "vite build --mode app",
    "tauri": "tauri",
    "test": "vitest run",
    "test:commonmark": "vitest run tests/commonmark.spec.ts",
    "test:security": "vitest run tests/security.spec.ts",
    "test:a11y": "vitest run tests/a11y.spec.ts",
    "test:contrast": "vitest run tests/contrast.spec.ts",
    "test:visual": "playwright test",
    "test:g3": "CLAYMARK_ROOT=$(pwd) tsx tests/__snapshots__/g3-eval.mjs",
    "bench:stress": "tsx bench/index.ts --suite stress",
    "bench:backtest": "tsx bench/index.ts --suite backtest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "pnpm audit --audit-level=high",
    "tsc": "tsc"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "dependencies": {
    "dompurify": "3.4.14",
    "hast-util-to-jsx-runtime": "2.3.0",
    "katex": "0.16.47",
    "mermaid": "10.9.8",
    "rehype-katex": "7.0.0",
    "rehype-pretty-code": "0.13.2",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.0",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.0",
    "shiki": "1.6.0",
    "unified": "11.0.4",
    "unist-util-visit": "5.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.0.0",
    "@testing-library/react": "15.0.7",
    "@types/hast": "3.0.5",
    "@types/mdast": "3.0.15",
    "@types/node": "20.12.7",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "1.6.1",
    "axe-core": "4.9.1",
    "eslint": "9.3.0",
    "hast-util-to-html": "9.0.3",
    "jsdom": "24.1.0",
    "playwright": "1.44.0",
    "prettier": "3.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "4.11.0",
    "typescript": "5.4.5",
    "typescript-eslint": "8.0.0",
    "vite": "5.4.21",
    "vite-plugin-dts": "5.0.3",
    "vite-plugin-pwa": "0.20.0",
    "vitest": "1.6.1"
  },
  "engines": {
    "node": "20.11.1",
    "pnpm": "9.1.0"
  },
  "packageManager": "pnpm@9.1.0"
}
